{
  "version": 8,
  "name": "cadastre_simple",
  "metadata": {"maputnik:renderer": "ol"},
  "sources": {
    "pci": {
      "type": "vector",
      "tiles": [
        "https://openmaptiles.data.gouv.fr/data/cadastre/{z}/{x}/{y}.pbf"
      ],
      "scheme": "xyz"
    }
  },
  "layers": [

    {
      "id": "batiment",
      "type": "fill",
      "source": "pci",
      "source-layer": "batiments",
      "paint": {
        "fill-color": "#768082",
        "fill-opacity": 1
      }
    },

    {
      "id": "parcelle",
      "type": "line",
      "source": "pci",
      "source-layer": "parcelles",
      "paint": {
        "line-color": "#4f4f4f",
        "line-width": 0.1
      }
    },

    {
      "id": "section",
      "type": "line",
      "source": "pci",
      "maxzoom": "8",
      "source-layer": "sections",
      "paint": {
        "line-color": "#343434",
        "line-width": 0.5
      }
    },

    {
      "id": "parcelle_label",
      "type": "symbol",
      "source": "pci",
      "source-layer": "parcelles",
      "minzoom": 16,
      "layout": {
        "text-field": "{numero}",
        "text-size": 8,
        "text-anchor": "center",
        "text-allow-overlap": false
      }
    },

    {
      "id": "section_label",
      "type": "symbol",
      "source": "pci",
      "source-layer": "sections",
      "minzoom": 14,
      "layout": {
        "text-field": "{code}",
        "text-size": 15,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#000000"
        
      }
    }

  ]
}
